# העתיקו לקובץ .env בשורש הפרויקט (לא לגיט)

# מפתח Groq — נשאר בשרת Vite בלבד (לא VITE_)
# קבלו מפתח ב־https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# אופציונלי: שם מודל (ברירת מחדל openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# כתובת ה־API לצ׳אט מהדפדפן
# מקומית: /api/chat (פרוקסי Vite → Groq)
# או Worker אחרי פריסה: https://YOUR_WORKER.workers.dev
VITE_CHAT_API_URL=/api/chat

# צ׳אט יועץ השקעות (נפרד מצ׳אט הבנק)
VITE_INVEST_CHAT_API_URL=/api/invest-chat

# Supabase — Project URL בלי /rest/v1/ + מפתח publishable (לא service_role)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
