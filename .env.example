# העתיקו לקובץ .env בשורש הפרויקט (לא לגיט)

# מפתח Groq — נשאר בשרת Vite בלבד (לא VITE_)
# קבלו מפתח ב־https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# אופציונלי: שם מודל (ברירת מחדל openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# כתובת ה־API לצ׳אט מהדפדפן
# מקומית: /api/chat (פרוקסי Vite → Groq)
# או Worker אחרי פריסה: https://YOUR_WORKER.workers.dev
VITE_CHAT_API_URL=/api/chat

# צ׳אט יועץ השקעות (נפרד מצ׳אט הבנק)
VITE_INVEST_CHAT_API_URL=/api/invest-chat

# Supabase — Project URL בלי /rest/v1/ + מפתח publishable (לא service_role)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ---------------------------------------------------------------------------
# סוכן bank-risk-expert (admin.html) — כל השורות מכאן ולמטה הן סודות שרת
# בלבד (לא VITE_), רצות רק ב-`npm run dev` המקומי, לעולם לא בבאנדל הסטטי.
# ---------------------------------------------------------------------------

# חיבור Postgres ישיר (לא ה-anon key!) — עוקף RLS לגמרי, כמו שהסוכן צריך.
# ב-Supabase: Project Settings → Database → Connection string → URI.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# מפתח API של Anthropic, ל-Claude Agent SDK שמריץ את הסקיל bank-risk-expert.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# סוד חתימה לטוקן ההתחברות של המנהל (NACHOM) — כל מחרוזת אקראית וארוכה.
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string

# הדוחות (7 התבניות) נשמרים כקבצי Markdown מקומיים בתיקיית reports/ —
# לא Google Docs. Service account "רגיל" (לא Google Workspace) לא מקבל
# מכסת אחסון ב-Drive ולא יכול ליצור מסמכים, אז ויתרנו על האפשרות הזו.
